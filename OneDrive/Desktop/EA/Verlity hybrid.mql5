   PrintFormat("║ Winning Trades:     %d (%.1f%%)", winning_trades_today, win_rate);
   PrintFormat("║ Daily P/L:          %.2f", daily_profit);
   PrintFormat("║ Daily P/L %%:        %.2f%%", daily_profit_pct);
   PrintFormat("║ Account Balance:    %.2f", current_balance);
   Print("╚═══════════════════════════════════════════════════════════╝");
   Print("");
}

