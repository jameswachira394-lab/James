//+------------------------------------------------------------------+
//| Input Parameters                                                  |
//+------------------------------------------------------------------+
input group "=== Regime Detection ==="
input int InpATRPeriod1M = 14;
input int InpATRPeriod5M = 14;
input int InpATRPeriod1H = 14;
input double InpCompressionThreshold = 0.6;
input double InpExpansionThreshold = 1.4;

input group "=== High Accuracy Filters ==="
input bool InpEnableMultiTF = true;
input bool InpEnableStructure = true;
input bool InpEnableVolume = true;
input bool InpEnableTrendStrength = true;
input int InpMinConfirmations = 3;
input double InpMinRiskReward = 2.0;
input int InpMinTradeQuality = 70;
input bool InpEnableSmartMoney = true;
input bool InpEnableMLPatterns = true;

input group "=== Support/Resistance ==="
input bool InpEnableSR = true;
input int InpSRLookback = 50;
input double InpSRMinATRDistance = 1.5;
input bool InpSRAvoidBreakouts = true;
input double InpSRBufferPips = 3.0;

input group "=== Sentiment & ATR ==="
input bool InpEnableSentiment = false;
input double InpSentimentThreshold = -0.3;
input double InpSentimentLotReduction = 0.5;
input bool InpEnableAdaptiveATR = true;
input double InpATRScalpCompress = 0.8;
input double InpATRScalpExpand = 1.2;
input double InpATRGridCompress = 0.5;
input double InpATRGridExpand = 0.8;

input group "=== Trade Filters ==="
input double InpMaxSpreadPips = 2.0;
input int InpMaxSlippage = 3;
input double InpTickVolatilityLimit = 3.0;
input bool InpTradeAsianSession = false;
input bool InpTradeLondonSession = true;
input bool InpTradeNYSession = true;
input bool InpUseNewsFilter = true;

input group "=== Scalping Module ==="
input bool InpEnableScalping = true;
input double InpScalpTPPips = 6.0;
input double InpScalpSLPips = 12.0;
input double InpScalpBEPips = 3.0;
input int InpMaxScalpTrades = 3;
input double InpScalpRiskPercent = 0.25;

input group "=== Grid Module (STRICT SAFETY) ==="
input bool InpEnableGrid = true;
input double InpGridMinPips = 10.0;
input double InpGridATRMultiplier = 0.5;
input int InpMaxGridLevels = 3;              // HARD LIMIT: 3 levels max
input double InpBasketTPPercent = 0.2;       // Grid closes on basket profit
input double InpGridPartialTPPercent = 0.1;  // Partial exit threshold
input double InpGridLotMultiplier = 1.0;     // NO MARTINGALE
input double InpGridLotScaling = 1.0;        // NO SCALING (set to 1.0 for safety)
input double InpMaxGridDrawdownPercent = 3.0;// HARD STOP: 3% grid DD
input double InpMaxGridExposureLots = 0.05;  // HARD CAP: 0.05 lots total
input int    InpGridCooldownMinutes = 30;    // Cooldown after grid stop

input group "=== Risk Management ==="
input double InpBaseLotSize = 0.01;
input double InpMaxGridRiskPercent = 1.0;
input int InpMaxTotalPositions = 5;
input double InpMaxEquityDrawdown = 10.0;
input double InpDynamicDDMultiplier = 1.5;
input int InpMinTradeIntervalSec = 30;

input group "=== General ==="
input int InpMagicNumber = 123456;
input string InpTradeComment = "EA_v3";
input bool InpEnableLogging = true;
input bool InpDebugMode = false;

//+------------------------------------------------------------------+
//| Global Variables                                                  |
//+------------------------------------------------------------------+
CTrade trade;
CPositionInfo posInfo;
CAccountInfo accInfo;

bool g_killSwitch = false;
double g_initialEquity = 0.0;
double g_peakEquity = 0.0;
datetime g_lastTradeTime = 0;
datetime g_lastSentimentUpdate = 0;
datetime g_lastSRUpdate = 0;
datetime g_lastEquityUpdate = 0;
datetime g_lastGridStopTime = 0;
datetime g_lastOBUpdate = 0;

double g_currentSentiment = 0.0;
double g_lastEquityCheck = 0.0;
bool g_partialExitDone = false;

int g_totalTrades = 0;
int g_winningTrades = 0;
int g_losingTrades = 0;

ulong g_lastProcessedDeal = 0;

struct SRLevel {
   double price;
   int touches;
   bool isSupport;
   datetime lastTouch;
   int strength;
};
SRLevel g_srLevels[];

struct OrderBlock {
   double high;
   double low;
   bool isBullish;
   datetime created;
   int strength;
};
OrderBlock g_orderBlocks[];

struct PricePattern {
   string name;
   double confidence;
   bool isBullish;
   datetime detected;
};
PricePattern g_lastPattern;

int g_atrHandle1M, g_atrHandle5M, g_atrHandle1H;
int g_maHandle1M, g_maHandle5M, g_maHandle15M, g_maHandle1H;

enum ENUM_MARKET_REGIME {
   REGIME_COMPRESSION,
   REGIME_EXPANSION,
   REGIME_DISLOCATION
};

enum ENUM_TRADE_TYPE {
   TRADE_SCALP,
   TRADE_GRID
};

enum ENUM_TREND_DIRECTION {
   TREND_UP,
   TREND_DOWN,
   TREND_SIDEWAYS
};

//+------------------------------------------------------------------+
//| Initialization                                                    |
//+------------------------------------------------------------------+
int OnInit() {
   // Configure trade execution
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(InpMaxSlippage);
   trade.SetTypeFilling(ORDER_FILLING_FOK);
   trade.SetAsyncMode(false);
   
   // Initialize equity tracking
   g_initialEquity = accInfo.Equity();
   g_peakEquity = g_initialEquity;
   g_lastEquityCheck = g_initialEquity;
   
   // Create ATR indicators
   g_atrHandle1M = iATR(_Symbol, PERIOD_M1, InpATRPeriod1M);
   g_atrHandle5M = iATR(_Symbol, PERIOD_M5, InpATRPeriod5M);
   g_atrHandle1H = iATR(_Symbol, PERIOD_H1, InpATRPeriod1H);
   
   if(g_atrHandle1M == INVALID_HANDLE || g_atrHandle5M == INVALID_HANDLE || g_atrHandle1H == INVALID_HANDLE) {
      Print("ERROR: Failed to create ATR indicators");
      return INIT_FAILED;
   }
   
   // Create MA indicators
   g_maHandle1M = iMA(_Symbol, PERIOD_M1, 20, 0, MODE_EMA, PRICE_CLOSE);
   g_maHandle5M = iMA(_Symbol, PERIOD_M5, 20, 0, MODE_EMA, PRICE_CLOSE);
   g_maHandle15M = iMA(_Symbol, PERIOD_M15, 20, 0, MODE_EMA, PRICE_CLOSE);
   g_maHandle1H = iMA(_Symbol, PERIOD_H1, 50, 0, MODE_EMA, PRICE_CLOSE);
   
   if(g_maHandle1M == INVALID_HANDLE || g_maHandle5M == INVALID_HANDLE || 
      g_maHandle15M == INVALID_HANDLE || g_maHandle1H == INVALID_HANDLE) {
      Print("ERROR: Failed to create MA indicators");
      return INIT_FAILED;
   }
   
   // Initialize pattern structure
   g_lastPattern.name = "";
   g_lastPattern.confidence = 0.0;
   g_lastPattern.isBullish = false;
   g_lastPattern.detected = 0;
   
   // Calculate initial SR and OB
   if(InpEnableSR) CalculateSRLevels();
   if(InpEnableSmartMoney) IdentifyOrderBlocks();
   
   Print("╔════════════════════════════════════════════════════════════╗");
   Print("║     AURIC EDGE CAPITAL - EA v3.2 INITIALIZED              ║");
   Print("╠════════════════════════════════════════════════════════════╣");
   Print("║  Symbol: ", _Symbol);
   Print("║  Initial Equity: $", DoubleToString(g_initialEquity, 2));
   Print("║  Min Quality: ", InpMinTradeQuality, "/100");
   Print("║  Min R:R: 1:", DoubleToString(InpMinRiskReward, 1));
   Print("║  Grid Safety: MAX 3 levels, 3% DD, 0.05 lot cap");
   Print("╚════════════════════════════════════════════════════════════╝");
   
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Deinitialization                                                  |
//+------------------------------------------------------------------+
void OnDeinit(const int reason) {
   // Release indicators
   if(g_atrHandle1M != INVALID_HANDLE) IndicatorRelease(g_atrHandle1M);
   if(g_atrHandle5M != INVALID_HANDLE) IndicatorRelease(g_atrHandle5M);
   if(g_atrHandle1H != INVALID_HANDLE) IndicatorRelease(g_atrHandle1H);
   if(g_maHandle1M != INVALID_HANDLE) IndicatorRelease(g_maHandle1M);
   if(g_maHandle5M != INVALID_HANDLE) IndicatorRelease(g_maHandle5M);
   if(g_maHandle15M != INVALID_HANDLE) IndicatorRelease(g_maHandle15M);
   if(g_maHandle1H != INVALID_HANDLE) IndicatorRelease(g_maHandle1H);
   
   // Free arrays
   ArrayFree(g_srLevels);
   ArrayFree(g_orderBlocks);
   
   // Calculate statistics
   double winRate = g_totalTrades > 0 ? (double)g_winningTrades / g_totalTrades * 100 : 0;
   double finalEquity = accInfo.Equity();
   double pnl = finalEquity - g_initialEquity;
   double pnlPercent = g_initialEquity > DBL_EPSILON ? (pnl / g_initialEquity) * 100 : 0;
   
   Print("╔════════════════════════════════════════════════════════════╗");
   Print("║              EA SHUTDOWN STATISTICS                        ║");
   Print("╠════════════════════════════════════════════════════════════╣");
   Print("║  Total Trades: ", g_totalTrades);
   Print("║  Winners: ", g_winningTrades, " | Losers: ", g_losingTrades);
   Print("║  Win Rate: ", DoubleToString(winRate, 2), "%");
   Print("║  Final Equity: $", DoubleToString(finalEquity, 2));
   Print("║  P&L: $", DoubleToString(pnl, 2), " (", DoubleToString(pnlPercent, 2), "%)");
   Print("║  Reason: ", GetUninitReasonText(reason));
   Print("╚════════════════════════════════════════════════════════════╝");
}

//+------------------------------------------------------------------+
//| Main Tick Function                                                |
//+------------------------------------------------------------------+
void OnTick() {
   // Update equity tracking
   UpdateEquityTracking();
   
   // Kill switch check
   if(g_killSwitch) return;
   
   // Global drawdown protection
   if(CheckEquityDrawdown()) {
      ActivateKillSwitch("Maximum equity drawdown exceeded");
      return;
   }
   
   // Periodic updates (every 5 seconds)
   static datetime lastUpdate = 0;
   if(TimeCurrent() - lastUpdate > 5) {
      // Update SR levels (every 5 minutes)
      if(InpEnableSR && TimeCurrent() - g_lastSRUpdate > 300) {
         CalculateSRLevels();
         g_lastSRUpdate = TimeCurrent();
      }
      
      // Update order blocks (every 10 minutes)
      if(InpEnableSmartMoney && TimeCurrent() - g_lastOBUpdate > 600) {
         IdentifyOrderBlocks();
         g_lastOBUpdate = TimeCurrent();
      }
      
      // Update sentiment (if enabled)
      if(InpEnableSentiment && TimeCurrent() - g_lastSentimentUpdate > 900) {
         UpdateSentiment();
         g_lastSentimentUpdate = TimeCurrent();
      }
      lastUpdate = TimeCurrent();
   }
   
   // Manage open positions
   ManageOpenPositions();
   
   // Check if trading is allowed
   if(!IsTradingAllowed()) return;
   
   // Classify market regime
   ENUM_MARKET_REGIME regime = ClassifyMarketRegime();
   if(regime == REGIME_DISLOCATION) return; // No trading during dislocations
   
   // Execute scalping logic
   if(InpEnableScalping && CountPositionsByType(TRADE_SCALP) < InpMaxScalpTrades) {
      ExecuteScalpingLogic(regime);
   }
   
   // Execute grid logic (ONLY in compression with strict safety)
   if(InpEnableGrid && regime == REGIME_COMPRESSION) {
      ExecuteGridLogic(regime);
   }
   
   // Check grid basket TP
   CheckGridBasketTP();
}

//+------------------------------------------------------------------+
//| Helper Functions                                                  |
//+------------------------------------------------------------------+
string OrderTypeToString(ENUM_ORDER_TYPE type) {
   return (type == ORDER_TYPE_BUY) ? "BUY" : "SELL";
}

string GetUninitReasonText(int reason) {
   switch(reason) {
      case REASON_PROGRAM: return "Program stopped";
      case REASON_REMOVE: return "Removed from chart";
      case REASON_RECOMPILE: return "Recompiled";
      case REASON_CHARTCHANGE: return "Chart changed";
      case REASON_CHARTCLOSE: return "Chart closed";
      case REASON_PARAMETERS: return "Parameters changed";
      case REASON_ACCOUNT: return "Account changed";
      case REASON_TEMPLATE: return "Template changed";
      case REASON_INITFAILED: return "Init failed";
      case REASON_CLOSE: return "Terminal closed";
      default: return "Unknown";
   }
}

//+------------------------------------------------------------------+
//| Regime Classification                                             |
//| CRITICAL: Determines if grid trading is allowed                  |
//+------------------------------------------------------------------+
ENUM_MARKET_REGIME ClassifyMarketRegime() {
   double atr1M[3], atr5M[3], atr1H[3];
   ArraySetAsSeries(atr1M, true);
   ArraySetAsSeries(atr5M, true);
   ArraySetAsSeries(atr1H, true);
   
   if(CopyBuffer(g_atrHandle1M, 0, 0, 3, atr1M) < 3) return REGIME_EXPANSION;
   if(CopyBuffer(g_atrHandle5M, 0, 0, 3, atr5M) < 3) return REGIME_EXPANSION;
   if(CopyBuffer(g_atrHandle1H, 0, 0, 3, atr1H) < 3) return REGIME_EXPANSION;
   
   // Calculate ATR ratios
   double ratio5M_1M = (atr1M[0] > DBL_EPSILON) ? atr5M[0] / atr1M[0] : 1.0;
   double ratio1H_5M = (atr5M[0] > DBL_EPSILON) ? atr1H[0] / atr5M[0] : 1.0;
   
   // Detect volatility spikes (dislocation)
   if(atr1M[1] > DBL_EPSILON && atr1M[0] > atr1M[1] * 2.5) return REGIME_DISLOCATION;
   if(atr5M[1] > DBL_EPSILON && atr5M[0] > atr5M[1] * 2.0) return REGIME_DISLOCATION;
   
   // Compression detection (safe for grid)
   if(ratio5M_1M < InpCompressionThreshold && ratio1H_5M < InpCompressionThreshold) 
      return REGIME_COMPRESSION;
   
   // Expansion detection
   if(ratio5M_1M > InpExpansionThreshold || ratio1H_5M > InpExpansionThreshold) 
      return REGIME_EXPANSION;
   
   return REGIME_COMPRESSION;
}

//+------------------------------------------------------------------+
//| Multi-Timeframe Trend Analysis                                    |
//+------------------------------------------------------------------+
ENUM_TREND_DIRECTION GetMultiTimeframeTrend() {
   if(!InpEnableMultiTF) return TREND_SIDEWAYS;
   
   double ma1M[3], ma5M[3], ma15M[3], ma1H[3];
   double close1M[3], close5M[3], close15M[3], close1H[3];
   
   ArraySetAsSeries(ma1M, true); ArraySetAsSeries(ma5M, true);
   ArraySetAsSeries(ma15M, true); ArraySetAsSeries(ma1H, true);
   ArraySetAsSeries(close1M, true); ArraySetAsSeries(close5M, true);
   ArraySetAsSeries(close15M, true); ArraySetAsSeries(close1H, true);
   
   if(CopyBuffer(g_maHandle1M, 0, 0, 3, ma1M) < 3) return TREND_SIDEWAYS;
   if(CopyBuffer(g_maHandle5M, 0, 0, 3, ma5M) < 3) return TREND_SIDEWAYS;
   if(CopyBuffer(g_maHandle15M, 0, 0, 3, ma15M) < 3) return TREND_SIDEWAYS;
   if(CopyBuffer(g_maHandle1H, 0, 0, 3, ma1H) < 3) return TREND_SIDEWAYS;
   
   if(CopyClose(_Symbol, PERIOD_M1, 0, 3, close1M) < 3) return TREND_SIDEWAYS;
   if(CopyClose(_Symbol, PERIOD_M5, 0, 3, close5M) < 3) return TREND_SIDEWAYS;
   if(CopyClose(_Symbol, PERIOD_M15, 0, 3, close15M) < 3) return TREND_SIDEWAYS;
   if(CopyClose(_Symbol, PERIOD_H1, 0, 3, close1H) < 3) return TREND_SIDEWAYS;
   
   int bullish = 0, bearish = 0;
   
   // M1 trend
   if(close1M[0] > ma1M[0] && ma1M[0] > ma1M[1]) bullish++;
   else if(close1M[0] < ma1M[0] && ma1M[0] < ma1M[1]) bearish++;
   
   // M5 trend
   if(close5M[0] > ma5M[0] && ma5M[0] > ma5M[1]) bullish++;
   else if(close5M[0] < ma5M[0] && ma5M[0] < ma5M[1]) bearish++;
   
   // M15 trend
   if(close15M[0] > ma15M[0] && ma15M[0] > ma15M[1]) bullish++;
   else if(close15M[0] < ma15M[0] && ma15M[0] < ma15M[1]) bearish++;
   
   // H1 trend (highest weight)
   if(close1H[0] > ma1H[0] && ma1H[0] > ma1H[1]) bullish++;
   else if(close1H[0] < ma1H[0] && ma1H[0] < ma1H[1]) bearish++;
   
   if(bullish >= 3) return TREND_UP;
   if(bearish >= 3) return TREND_DOWN;
   return TREND_SIDEWAYS;
}

//+------------------------------------------------------------------+
//| Market Structure Analysis                                         |
//+------------------------------------------------------------------+
bool IsMarketStructureBullish() {
   if(!InpEnableStructure) return true;
   
   double high[30], low[30];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   
   if(CopyHigh(_Symbol, PERIOD_M5, 0, 30, high) < 30) return false;
   if(CopyLow(_Symbol, PERIOD_M5, 0, 30, low) < 30) return false;
   
   int hh = 0, hl = 0;
   for(int i = 5; i < 25; i += 5) {
      if(high[0] > high[i]) hh++;
      if(low[0] > low[i]) hl++;
   }
   
   return (hh >= 3 && hl >= 3); // Higher highs and higher lows
}

bool IsMarketStructureBearish() {
   if(!InpEnableStructure) return true;
   
   double high[30], low[30];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   
   if(CopyHigh(_Symbol, PERIOD_M5, 0, 30, high) < 30) return false;
   if(CopyLow(_Symbol, PERIOD_M5, 0, 30, low) < 30) return false;
   
   int lh = 0, ll = 0;
   for(int i = 5; i < 25; i += 5) {
      if(high[0] < high[i]) lh++;
      if(low[0] < low[i]) ll++;
   }
   
   return (lh >= 3 && ll >= 3); // Lower highs and lower lows
}

//+------------------------------------------------------------------+
//| Volume Confirmation                                               |
//+------------------------------------------------------------------+
bool IsVolumeConfirming(bool isBuy) {
   if(!InpEnableVolume) return true;
   
   long volume[10];
   ArraySetAsSeries(volume, true);
   
   if(CopyTickVolume(_Symbol, PERIOD_M1, 0, 10, volume) < 10) return false;
   
   long avgVol = 0;
   for(int i = 1; i < 10; i++) avgVol += volume[i];
   avgVol = avgVol > 0 ? avgVol / 9 : 1;
   
   return (volume[0] > avgVol * 1.2); // Current volume > 120% average
}

//+------------------------------------------------------------------+
//| Trend Strength Calculation                                        |
//+------------------------------------------------------------------+
double CalculateTrendStrength() {
   if(!InpEnableTrendStrength) return 50.0;
   
   double close[50];
   ArraySetAsSeries(close, true);
   
   if(CopyClose(_Symbol, PERIOD_M5, 0, 50, close) < 50) return 50.0;
   
   double upMoves = 0, downMoves = 0;
   
   for(int i = 1; i < 50; i++) {
      double change = close[i-1] - close[i];
      if(change > 0) upMoves += change;
      else downMoves += MathAbs(change);
   }
   
   double total = upMoves + downMoves;
   return (total < DBL_EPSILON) ? 50.0 : (MathMax(upMoves, downMoves) / total) * 100;
}

//+------------------------------------------------------------------+
//| Smart Money - Order Block Detection                              |
//+------------------------------------------------------------------+
void IdentifyOrderBlocks() {
   ArrayFree(g_orderBlocks);
   
   double high[100], low[100], open[100], close[100];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true);
   ArraySetAsSeries(open, true); ArraySetAsSeries(close, true);
   
   if(CopyHigh(_Symbol, PERIOD_M5, 0, 100, high) < 100) return;
   if(CopyLow(_Symbol, PERIOD_M5, 0, 100, low) < 100) return;
   if(CopyOpen(_Symbol, PERIOD_M5, 0, 100, open) < 100) return;
   if(CopyClose(_Symbol, PERIOD_M5, 0, 100, close) < 100) return;
   
   for(int i = 10; i < 90; i++) {
      double body = MathAbs(close[i] - open[i]);
      double candle = high[i] - low[i];
      
      if(candle < DBL_EPSILON) continue;
      
      // Bullish order block: strong bullish candle followed by strong move up
      if(close[i] > open[i] && body > candle * 0.7) {
         if(i >= 5 && close[i-5] > close[i] * 1.001) {
            int s = ArraySize(g_orderBlocks);
            ArrayResize(g_orderBlocks, s + 1);
            g_orderBlocks[s].high = high[i];
            g_orderBlocks[s].low = low[i];
            g_orderBlocks[s].isBullish = true;
            g_orderBlocks[s].created = iTime(_Symbol, PERIOD_M5, i);
            g_orderBlocks[s].strength = 3;
         }
      }
      
      // Bearish order block: strong bearish candle followed by strong move down
      if(close[i] < open[i] && body > candle * 0.7) {
         if(i >= 5 && close[i-5] < close[i] * 0.999) {
            int s = ArraySize(g_orderBlocks);
            ArrayResize(g_orderBlocks, s + 1);
            g_orderBlocks[s].high = high[i];
            g_orderBlocks[s].low = low[i];
            g_orderBlocks[s].isBullish = false;
            g_orderBlocks[s].created = iTime(_Symbol, PERIOD_M5, i);
            g_orderBlocks[s].strength = 3;
         }
      }
   }
}

bool IsNearOrderBlock(double price, bool &isBullishOB) {
   if(!InpEnableSmartMoney) return false;
   
   int obCount = ArraySize(g_orderBlocks);
   if(obCount == 0) return false;
   
   double buffer = InpSRBufferPips * 10 * _Point * 2;
   
   for(int i = 0; i < obCount; i++) {
      if(price >= g_orderBlocks[i].low - buffer && price <= g_orderBlocks[i].high + buffer) {
         isBullishOB = g_orderBlocks[i].isBullish;
         return true;
      }
   }
   
   return false;
}

//+------------------------------------------------------------------+
//| Pattern Recognition                                               |
//+------------------------------------------------------------------+
void DetectPricePatterns() {
   if(!InpEnableMLPatterns) return;
   
   double high[20], low[20], close[20];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   
   if(CopyHigh(_Symbol, PERIOD_M5, 0, 20, high) < 20) return;
   if(CopyLow(_Symbol, PERIOD_M5, 0, 20, low) < 20) return;
   if(CopyClose(_Symbol, PERIOD_M5, 0, 20, close) < 20) return;
   
   // Double bottom pattern
   for(int i = 5; i < 15; i++) {
      if(low[0] > DBL_EPSILON && MathAbs(low[0] - low[i]) < low[0] * 0.002 && close[0] > close[i]) {
         g_lastPattern.name = "Double Bottom";
         g_lastPattern.confidence = 0.75;
         g_lastPattern.isBullish = true;
         g_lastPattern.detected = TimeCurrent();
         return;
      }
   }
   
   // Double top pattern
   for(int i = 5; i < 15; i++) {
      if(high[0] > DBL_EPSILON && MathAbs(high[0] - high[i]) < high[0] * 0.002 && close[0] < close[i]) {
         g_lastPattern.name = "Double Top";
         g_lastPattern.confidence = 0.75;
         g_lastPattern.isBullish = false;
         g_lastPattern.detected = TimeCurrent();
         return;
      }
   }
}

bool IsPatternConfirming(bool isBuy) {
   if(!InpEnableMLPatterns) return true;
   if(g_lastPattern.name == "") return true;
   if(TimeCurrent() - g_lastPattern.detected > 1800) return true; // Pattern expires after 30 min
   
   if(isBuy && g_lastPattern.isBullish && g_lastPattern.confidence > 0.65) return true;
   if(!isBuy && !g_lastPattern.isBullish && g_lastPattern.confidence >
   0.65) return true;
return false;
}
//+------------------------------------------------------------------+
//| Trade Quality Score (0-100)                                       |
//+------------------------------------------------------------------+
int CalculateTradeQuality(ENUM_ORDER_TYPE orderType, ENUM_MARKET_REGIME regime) {
int score = 0;
bool isBuy = (orderType == ORDER_TYPE_BUY);
// Multi-timeframe alignment (20 points)
ENUM_TREND_DIRECTION mtf = GetMultiTimeframeTrend();
if((isBuy && mtf == TREND_UP) || (!isBuy && mtf == TREND_DOWN)) score += 20;
else if(mtf == TREND_SIDEWAYS) score += 10;
// Market structure (20 points)
if((isBuy && IsMarketStructureBullish()) || (!isBuy && IsMarketStructureBearish())) score += 20;
// Volume confirmation (15 points)
if(IsVolumeConfirming(isBuy)) score += 15;
// Trend strength (15 points)
double strength = CalculateTrendStrength();
if(strength > 60) score += 15;
else if(strength > 55) score += 10;
else if(strength > 50) score += 5;
// Order block alignment (15 points)
bool isBullishOB = false;
bool nearOB = IsNearOrderBlock(SymbolInfoDouble(_Symbol, isBuy ? SYMBOL_ASK : SYMBOL_BID), isBullishOB);
if(nearOB && ((isBuy && isBullishOB) || (!isBuy && !isBullishOB))) score += 15;
// Pattern confirmation (10 points)
if(IsPatternConfirming(isBuy)) score += 10;
// Regime bonus (5 points)
if(regime == REGIME_COMPRESSION) score += 5;
return score;
}
//+------------------------------------------------------------------+
//| Risk-Reward Validation                                            |
//+------------------------------------------------------------------+
bool ValidateRiskReward(ENUM_ORDER_TYPE orderType, double entry, double sl, double tp) {
double risk = MathAbs(entry - sl);
double reward = MathAbs(tp - entry);
if(risk < DBL_EPSILON) return false;
double rr = reward / risk;
return (rr >= InpMinRiskReward);
}
//+------------------------------------------------------------------+
//| Count Confirmations                                               |
//+------------------------------------------------------------------+
int CountConfirmations(ENUM_ORDER_TYPE orderType, ENUM_MARKET_REGIME regime) {
int count = 0;
bool isBuy = (orderType == ORDER_TYPE_BUY);
ENUM_TREND_DIRECTION mtf = GetMultiTimeframeTrend();
if((isBuy && mtf == TREND_UP) || (!isBuy && mtf == TREND_DOWN)) count++;
if((isBuy && IsMarketStructureBullish()) || (!isBuy && IsMarketStructureBearish())) count++;
if(IsVolumeConfirming(isBuy)) count++;
double strength = CalculateTrendStrength();
if(strength > 60) count++;
bool isBullishOB = false;
if(IsNearOrderBlock(SymbolInfoDouble(_Symbol, isBuy ? SYMBOL_ASK : SYMBOL_BID), isBullishOB)) {
if((isBuy && isBullishOB) || (!isBuy && !isBullishOB)) count++;
}
return count;
}
//+------------------------------------------------------------------+
//| Support/Resistance Level Calculation                             |
//+------------------------------------------------------------------+
void CalculateSRLevels() {
ArrayFree(g_srLevels);
double high[50], low[50];
ArraySetAsSeries(high, true);
ArraySetAsSeries(low, true);
int bars = InpSRLookback;
if(CopyHigh(_Symbol, PERIOD_M5, 0, bars, high) < bars) return;
if(CopyLow(_Symbol, PERIOD_M5, 0, bars, low) < bars) return;
double atr1H[1];
ArraySetAsSeries(atr1H, true);
if(CopyBuffer(g_atrHandle1H, 0, 0, 1, atr1H) < 1) return;
double minDist = atr1H[0] * InpSRMinATRDistance;
// Find swing highs (resistance)
for(int i = 2; i < bars - 2; i++) {
if(high[i] > high[i-1] && high[i] > high[i-2] && high[i] > high[i+1] && high[i] > high[i+2]) {
AddSRLevel(high[i], false, minDist);
}
  // Find swing lows (support)
  if(low[i] < low[i-1] && low[i] < low[i-2] && low[i] < low[i+1] && low[i] < low[i+2]) {
     AddSRLevel(low[i], true, minDist);
  }
}
}
void AddSRLevel(double price, bool isSupport, double minDist) {
int srCount = ArraySize(g_srLevels);
// Check if level already exists nearby
for(int i = 0; i < srCount; i++) {
if(MathAbs(g_srLevels[i].price - price) < minDist) {
g_srLevels[i].touches++;
g_srLevels[i].strength = MathMin(5, g_srLevels[i].touches);
g_srLevels[i].lastTouch = TimeCurrent();
return;
}
}
// Add new level
int s = ArraySize(g_srLevels);
ArrayResize(g_srLevels, s + 1);
g_srLevels[s].price = price;
g_srLevels[s].touches = 1;
g_srLevels[s].isSupport = isSupport;
g_srLevels[s].lastTouch = TimeCurrent();
g_srLevels[s].strength = 1;
}
bool IsNearSRLevel(double price, bool checkBreak, double &nearestSR) {
if(!InpEnableSR) return false;
int srCount = ArraySize(g_srLevels);
if(srCount == 0) return false;
double buffer = InpSRBufferPips * 10 * _Point;
for(int i = 0; i < srCount; i++) {
if(MathAbs(price - g_srLevels[i].price) < buffer) {
nearestSR = g_srLevels[i].price;
     // Check for breakout (avoid trading at breakout points)
     if(checkBreak && InpSRAvoidBreakouts) {
        double close[3];
        ArraySetAsSeries(close, true);
        if(CopyClose(_Symbol, PERIOD_M5, 0, 3, close) >= 3) {
           bool breaking = (g_srLevels[i].isSupport && close[0] < g_srLevels[i].price && close[1] > g_srLevels[i].price) ||
                         (!g_srLevels[i].isSupport && close[0] > g_srLevels[i].price && close[1] < g_srLevels[i].price);
           if(breaking) return true; // Reject trade at breakout
        }
     }
     return true;
  }
}
return false;
}
void AdjustTPSLForSR(ENUM_ORDER_TYPE orderType, double &tp, double &sl) {
if(!InpEnableSR) return;
int srCount = ArraySize(g_srLevels);
if(srCount == 0) return;
double price = (orderType == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
double nearestTP = 0, minDist = 999999;
// Find nearest SR level in TP direction
for(int i = 0; i < srCount; i++) {
bool inTPDir = (orderType == ORDER_TYPE_BUY && g_srLevels[i].price > price) ||
(orderType == ORDER_TYPE_SELL && g_srLevels[i].price < price);
  if(inTPDir) {
     double dist = MathAbs(g_srLevels[i].price - price);
     if(dist < minDist) {
        minDist = dist;
        nearestTP = g_srLevels[i].price;
     }
  }
}
// Adjust TP to stop before SR level
if(nearestTP > DBL_EPSILON) {
double buffer = InpSRBufferPips * 10 * _Point;
if(orderType == ORDER_TYPE_BUY && nearestTP < tp) tp = nearestTP - buffer;
else if(orderType == ORDER_TYPE_SELL && nearestTP > tp) tp = nearestTP + buffer;
}
}
//+------------------------------------------------------------------+
//| Sentiment Analysis (Simplified)                                  |
//+------------------------------------------------------------------+
void UpdateSentiment() {
double close[20];
ArraySetAsSeries(close, true);
if(CopyClose(_Symbol, PERIOD_M5, 0, 20, close) < 20) return;
double avgChange = 0;
for(int i = 1; i < 20; i++) {
if(close[i] > DBL_EPSILON) avgChange += (close[i-1] - close[i]) / close[i];
}
g_currentSentiment = avgChange / 19.0 * 100;
}
bool CheckSentimentFilter(ENUM_ORDER_TYPE orderType) {
if(!InpEnableSentiment) return true;
if(g_currentSentiment < InpSentimentThreshold && orderType == ORDER_TYPE_BUY) return false;
if(g_currentSentiment > -InpSentimentThreshold && orderType == ORDER_TYPE_SELL) return false;
return true;
}
double GetSentimentLotMultiplier(ENUM_ORDER_TYPE orderType) {
if(!InpEnableSentiment) return 1.0;
bool against = (orderType == ORDER_TYPE_BUY && g_currentSentiment < 0) ||
(orderType == ORDER_TYPE_SELL && g_currentSentiment > 0);
return against ? InpSentimentLotReduction : 1.0;
}
double GetAdaptiveATRMultiplier(ENUM_MARKET_REGIME regime, bool isGrid) {
if(!InpEnableAdaptiveATR) return isGrid ? InpGridATRMultiplier : 1.0;
if(isGrid) return (regime == REGIME_COMPRESSION) ? InpATRGridCompress : InpATRGridExpand;
return (regime == REGIME_COMPRESSION) ? InpATRScalpCompress : InpATRScalpExpand;
}
void AdjustSLTPForRegime(ENUM_MARKET_REGIME regime, double &slPips, double &tpPips) {
if(!InpEnableAdaptiveATR) return;
double mult = (regime == REGIME_COMPRESSION) ? 0.8 : 1.3;
slPips *= mult;
tpPips *= mult;
}
//+------------------------------------------------------------------+
//| SCALPING MODULE - Mean Reversion Strategy                        |
//| Enters on price deviation from short-term MA                     |
//+------------------------------------------------------------------+
void ExecuteScalpingLogic(ENUM_MARKET_REGIME regime) {
// Update pattern detection
DetectPricePatterns();
double close[20];
ArraySetAsSeries(close, true);
if(CopyClose(_Symbol, PERIOD_M1, 0, 20, close) < 20) return;
// Calculate simple moving average
double sma = 0;
for(int i = 0; i < 10; i++) sma += close[i];
sma /= 10.0;
// Calculate deviation in pips
double deviation = (close[0] - sma) / _Point / 10.0;
double threshold = 3.0 * GetAdaptiveATRMultiplier(regime, false);
// Mean reversion signals (only in compression)
bool buySignal = deviation < -threshold && regime == REGIME_COMPRESSION;
bool sellSignal = deviation > threshold && regime == REGIME_COMPRESSION;
if(buySignal) {
// Multi-layer validation
if(CountConfirmations(ORDER_TYPE_BUY, regime) < InpMinConfirmations) return;
if(CalculateTradeQuality(ORDER_TYPE_BUY, regime) < InpMinTradeQuality) return;
  // SR level check
  double nearestSR = 0;
  if(IsNearSRLevel(SymbolInfoDouble(_Symbol, SYMBOL_ASK), true, nearestSR)) return;
  
  // Sentiment filter
  if(!CheckSentimentFilter(ORDER_TYPE_BUY)) return;
  
  OpenScalpTrade(ORDER_TYPE_BUY, regime, CalculateTradeQuality(ORDER_TYPE_BUY, regime));
} else if(sellSignal) {
// Multi-layer validation
if(CountConfirmations(ORDER_TYPE_SELL, regime) < InpMinConfirmations) return;
if(CalculateTradeQuality(ORDER_TYPE_SELL, regime) < InpMinTradeQuality) return;
  // SR level check
  double nearestSR = 0;
  if(IsNearSRLevel(SymbolInfoDouble(_Symbol, SYMBOL_BID), true, nearestSR)) return;
  
  // Sentiment filter
  if(!CheckSentimentFilter(ORDER_TYPE_SELL)) return;
  
  OpenScalpTrade(ORDER_TYPE_SELL, regime, CalculateTradeQuality(ORDER_TYPE_SELL, regime));
}
}
void OpenScalpTrade(ENUM_ORDER_TYPE orderType, ENUM_MARKET_REGIME regime, int quality) {
double price = (orderType == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
// Calculate SL/TP with regime adjustment
double slPips = InpScalpSLPips;
double tpPips = InpScalpTPPips;
AdjustSLTPForRegime(regime, slPips, tpPips);
// Calculate lot size with sentiment adjustment
double sentMult = GetSentimentLotMultiplier(orderType);
double lotSize = CalculateLotSize(slPips, InpScalpRiskPercent) * sentMult;
// Calculate TP and SL
double tpPoints = tpPips * 10 * _Point;
double slPoints = slPips * 10 * _Point;
double tp = (orderType == ORDER_TYPE_BUY) ? price + tpPoints : price - tpPoints;
double sl = (orderType == ORDER_TYPE_BUY) ? price - slPoints : price + slPoints;
// Adjust for SR levels
AdjustTPSLForSR(orderType, tp, sl);
// Validate R:R
if(!ValidateRiskReward(orderType, price, sl, tp)) {
LogMessage("Trade rejected: R:R < " + DoubleToString(InpMinRiskReward, 1));
return;
}
// Normalize prices
tp = NormalizeDouble(tp, _Digits);
sl = NormalizeDouble(sl, _Digits);
lotSize = NormalizeDouble(lotSize, 2);
// Create comment with quality score
string comment = InpTradeComment + "_SCALP_Q" + IntegerToString(quality);
// Open position
if(trade.PositionOpen(_Symbol, orderType, lotSize, price, sl, tp, comment)) {
g_totalTrades++;
g_lastTradeTime = TimeCurrent();
LogMessage("✓ SCALP: " + OrderTypeToString(orderType) + " | Lot:" + DoubleToString(lotSize, 2) + " | Q:" + IntegerToString(quality));
} else {
LogMessage("✗ SCALP Failed: " + IntegerToString(trade.ResultRetcode()) + " - " + trade.ResultRetcodeDescription());
}
}
//+------------------------------------------------------------------+
//| GRID MODULE - CRITICAL SAFETY IMPLEMENTATION                     |
//| Maximum 3 levels, strict exposure limits, compression-only       |
//+------------------------------------------------------------------+
bool GridSafetyCheck() {
// Check 1: Equity-based drawdown limit (3% max)
double eq = accInfo.Equity();
if(g_peakEquity < DBL_EPSILON) return false;
double dd = (g_peakEquity - eq) / g_peakEquity * 100.0;
if(dd > InpMaxGridDrawdownPercent) {
LogMessage("Grid BLOCKED: Drawdown " + DoubleToString(dd, 2) + "% > " + DoubleToString(InpMaxGridDrawdownPercent, 2) + "%");
return false;
}
// Check 2: Total grid exposure limit (0.05 lots max)
double exposure = 0;
for(int i = PositionsTotal()-1; i >= 0; i--) {
if(posInfo.SelectByIndex(i) &&
posInfo.Symbol() == _Symbol &&
posInfo.Magic() == InpMagicNumber &&
StringFind(posInfo.Comment(), "GRID") >= 0) {
exposure += posInfo.Volume();
}
}
if(exposure >= InpMaxGridExposureLots) {
LogMessage("Grid BLOCKED: Exposure " + DoubleToString(exposure, 2) + " >= " + DoubleToString(InpMaxGridExposureLots, 2));
return false;
}
// Check 3: Cooldown after forced shutdown
if(g_lastGridStopTime > 0 && TimeCurrent() - g_lastGridStopTime < InpGridCooldownMinutes * 60) {
return false;
}
return true;
}
void ExecuteGridLogic(ENUM_MARKET_REGIME regime) {
// CRITICAL: Grid safety check first
if(!GridSafetyCheck()) {
g_lastGridStopTime = TimeCurrent();
return;
}
// Verify sideways market (no strong trend)
if(!IsSidewaysMarket()) return;
// Count existing grid positions
int gridPos = CountPositionsByType(TRADE_GRID);
// HARD LIMIT: Max 3 levels per direction (6 total)
if(gridPos >= InpMaxGridLevels * 2) return;
// Get ATR for dynamic spacing
double atr5M[1];
ArraySetAsSeries(atr5M, true);
if(CopyBuffer(g_atrHandle5M, 0, 0, 1, atr5M) < 1) return;
double atrMult = GetAdaptiveATRMultiplier(regime, true);
double gridStep = MathMax(InpGridMinPips, atr5M[0] / _Point / 10.0 * atrMult) * 10 * _Point;
// Open initial grid if none exist
if(gridPos == 0) {
OpenGridTrade(ORDER_TYPE_BUY, 0, regime);
OpenGridTrade(ORDER_TYPE_SELL, 0, regime);
} else {
// Check and open additional grid levels
CheckAndOpenGridLevel(gridStep, regime);
}
}
bool IsSidewaysMarket() {
double high[20], low[20];
ArraySetAsSeries(high, true);
ArraySetAsSeries(low, true);
if(CopyHigh(_Symbol, PERIOD_M5, 0, 20, high) < 20) return false;
if(CopyLow(_Symbol, PERIOD_M5, 0, 20, low) < 20) return false;
// Check for range-bound price action
bool hh = false, ll = false;
for(int i = 1; i < 15; i++) {
if(high[i] > high[0]) hh = true;
if(low[i] < low[0]) ll = true;
}
return !(hh && ll); // No clear trend
}
void OpenGridTrade(ENUM_ORDER_TYPE orderType, int level, ENUM_MARKET_REGIME regime) {
// CRITICAL: Respect higher timeframe trend
ENUM_TREND_DIRECTION trend = GetMultiTimeframeTrend();
if(trend == TREND_UP && orderType == ORDER_TYPE_SELL) {
LogMessage("Grid BLOCKED: Sell against uptrend");
return;
}
if(trend == TREND_DOWN && orderType == ORDER_TYPE_BUY) {
LogMessage("Grid BLOCKED: Buy against downtrend");
return;
}
// Calculate lot size (NO MARTINGALE - uses InpGridLotScaling which should be 1.0)
double baseMult = MathPow(InpGridLotScaling, level);
double lotSize = CalculateLotSize(InpScalpSLPips * 2, InpMaxGridRiskPercent / InpMaxGridLevels) * baseMult * InpGridLotMultiplier;
lotSize = NormalizeDouble(lotSize, 2);
// Validate lot size
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
if(lotSize < minLot || lotSize > maxLot) {
LogMessage("Grid BLOCKED: Invalid lot size " + DoubleToString(lotSize, 2));
return;
}
string comment = InpTradeComment + "_GRID_L" + IntegerToString(level);
// Open position without SL/TP (basket managed)
double price = (orderType == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
if(trade.PositionOpen(_Symbol, orderType, lotSize, price, 0, 0, comment)) {
LogMessage("Grid: " + OrderTypeToString(orderType) + " L" + IntegerToString(level) + " | Lot:" + DoubleToString(lotSize, 2));
} else {
LogMessage("Grid Failed: " + IntegerToString(trade.ResultRetcode()));
}
}
void CheckAndOpenGridLevel(double gridStep, ENUM_MARKET_REGIME regime) {
double lastBuy = 0, lastSell = 0;
int buyLvl = 0, sellLvl = 0;
// Find last grid positions
for(int i = PositionsTotal() - 1; i >= 0; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), "GRID") < 0) continue;
  if(posInfo.PositionType() == POSITION_TYPE_BUY) {
     if(lastBuy < DBL_EPSILON || posInfo.PriceOpen() > lastBuy) lastBuy = posInfo.PriceOpen();
     buyLvl++;
  } else {
     if(lastSell < DBL_EPSILON || posInfo.PriceOpen() > lastSell) lastSell = posInfo.PriceOpen();
     sellLvl++;
  }
}
double current = SymbolInfoDouble(_Symbol, SYMBOL_BID);
// Open next buy level if price moved down
if(buyLvl < InpMaxGridLevels && lastBuy > DBL_EPSILON && current < lastBuy - gridStep) {
OpenGridTrade(ORDER_TYPE_BUY, buyLvl, regime);
}
// Open next sell level if price moved up
if(sellLvl < InpMaxGridLevels && lastSell > DBL_EPSILON && current > lastSell + gridStep) {
OpenGridTrade(ORDER_TYPE_SELL, sellLvl, regime);
}
}
//+------------------------------------------------------------------+
//| Trade Filters                                                     |
//+------------------------------------------------------------------+
bool IsTradingAllowed() {
if(g_killSwitch) return false;
// Minimum interval between trades
if(TimeCurrent() - g_lastTradeTime < InpMinTradeIntervalSec) return false;
// Dynamic position limit based on equity volatility
int maxPos = InpMaxTotalPositions;
double eqChange = (g_lastEquityCheck > DBL_EPSILON) ? MathAbs(accInfo.Equity() - g_lastEquityCheck) / g_lastEquityCheck : 0;
if(eqChange > 0.02) maxPos = (int)MathMax(2, InpMaxTotalPositions * 0.6);
if(PositionsTotal() >= maxPos) return false;
// Spread filter
if(!CheckSpreadFilter()) return false;
// Volatility filter
if(!CheckTickVolatilityFilter()) return false;
// Session filter
if(!CheckSessionFilter()) return false;
// News filter
if(InpUseNewsFilter && !CheckNewsFilter()) return false;
return true;
}
bool CheckSpreadFilter() {
double spread = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID)) / _Point / 10.0;
return (spread <= InpMaxSpreadPips);
}
bool CheckTickVolatilityFilter() {
double atr1M[2];
ArraySetAsSeries(atr1M, true);
if(CopyBuffer(g_atrHandle1M, 0, 0, 2, atr1M) < 2) return false;
MqlTick tick;
if(!SymbolInfoTick(_Symbol, tick)) return false;
double tickMove = MathAbs(tick.bid - tick.last);
return (atr1M[0] > DBL_EPSILON && tickMove <= atr1M[0] * InpTickVolatilityLimit);
}
bool CheckSessionFilter() {
MqlDateTime dt;
TimeToStruct(TimeCurrent(), dt);
int hour = dt.hour;
bool asian = (hour >= 23 || hour < 8);
bool london = (hour >= 7 && hour < 16);
bool ny = (hour >= 12 && hour < 21);
return (asian && InpTradeAsianSession) || (london && InpTradeLondonSession) || (ny && InpTradeNYSession);
}
bool CheckNewsFilter() {
MqlDateTime dt;
TimeToStruct(TimeCurrent(), dt);
int hour = dt.hour, minute = dt.minute;
// Avoid major news times (simplified)
if((hour == 13 && minute >= 15) || (hour == 14 && minute == 0)) return false; // 13:30 EST news
if((hour == 18 && minute >= 45) || (hour == 19 && minute <= 30)) return false; // FOMC minutes
return true;
}
//+------------------------------------------------------------------+
//| Position Management                                               |
//+------------------------------------------------------------------+
void ManageOpenPositions() {
for(int i = PositionsTotal() - 1; i >= 0; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
  // Only manage scalp positions (grid uses basket TP)
  if(StringFind(posInfo.Comment(), "_SCALP") >= 0) {
     ManageScalpPosition(posInfo.Ticket());
  }
}
}
void ManageScalpPosition(ulong ticket) {
if(!posInfo.SelectByTicket(ticket)) return;
double open = posInfo.PriceOpen();
double current = (posInfo.PositionType() == POSITION_TYPE_BUY) ?
SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
// Calculate profit in pips
double profitPips = (posInfo.PositionType() == POSITION_TYPE_BUY) ?
(current - open) / _Point / 10.0 :
(open - current) / _Point / 10.0;
// Move to break-even when profit threshold reached
if(profitPips >= InpScalpBEPips) {
double currentSL = posInfo.StopLoss();
double newSL = open;
  bool needUpdate = false;
  if(posInfo.PositionType() == POSITION_TYPE_BUY) {
     if(currentSL < DBL_EPSILON || currentSL < newSL - _Point) needUpdate = true;
  } else {
     if(currentSL < DBL_EPSILON || currentSL > newSL + _Point) needUpdate = true;
  }
  
  if(needUpdate) {
     if(trade.PositionModify(ticket, NormalizeDouble(newSL, _Digits), posInfo.TakeProfit())) {
        LogMessage("BE set for #" + IntegerToString(ticket));
     }
  }
}
}
//+------------------------------------------------------------------+
//| Risk Management                                                   |
//+------------------------------------------------------------------+
double CalculateLotSize(double slPips, double riskPercent) {
double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
if(tickValue < DBL_EPSILONContinue8:26 AM|| tickSize < DBL_EPSILON) return minLot;
double riskAmount = accInfo.Equity() * riskPercent / 100.0;
double slPoints = slPips * 10;
double lotSize = riskAmount / (slPoints * tickValue / tickSize);
lotSize = MathFloor(lotSize / lotStep) * lotStep;
lotSize = MathMax(lotSize, minLot);
lotSize = MathMin(lotSize, maxLot);
return lotSize;
}
int CountPositionsByType(ENUM_TRADE_TYPE type) {
int count = 0;
string search = (type == TRADE_SCALP) ? "_SCALP" : "GRID";
for(int i = 0; i < PositionsTotal(); i++) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), search) >= 0) count++;
}
return count;
}
void UpdateEquityTracking() {
double eq = accInfo.Equity();
if(eq > g_peakEquity) g_peakEquity = eq;
// Update last equity check every 5 minutes
if(TimeCurrent() - g_lastEquityUpdate > 300) {
g_lastEquityCheck = eq;
g_lastEquityUpdate = TimeCurrent();
}
}
bool CheckEquityDrawdown() {
double eq = accInfo.Equity();
if(g_peakEquity < DBL_EPSILON) g_peakEquity = eq;
if(eq < DBL_EPSILON) return false;
// Total drawdown from peak
double dd = (g_peakEquity - eq) / g_peakEquity * 100.0;
// Recent drawdown (last 5 minutes)
double recentDD = (g_lastEquityCheck > DBL_EPSILON) ? (g_lastEquityCheck - eq) / g_lastEquityCheck * 100.0 : 0;
// Trigger on severe recent DD or max total DD
if(recentDD > InpMaxEquityDrawdown * 0.5 * InpDynamicDDMultiplier) return true;
if(dd >= InpMaxEquityDrawdown) return true;
return false;
}
void ActivateKillSwitch(string reason) {
g_killSwitch = true;
Print("╔════════════════════════════════════════════════════════════╗");
Print("║            🚨 KILL SWITCH ACTIVATED 🚨                    ║");
Print("╠════════════════════════════════════════════════════════════╣");
Print("║  Reason: ", reason);
Print("║  Equity: $", DoubleToString(accInfo.Equity(), 2));
Print("║  Peak: $", DoubleToString(g_peakEquity, 2));
Print("╚════════════════════════════════════════════════════════════╝");
CloseAllPositions();
Alert("EA EMERGENCY STOP: " + reason);
}
void CloseAllPositions() {
int closed = 0;
for(int i = PositionsTotal() - 1; i >= 0; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
  if(trade.PositionClose(posInfo.Ticket())) closed++;
}
LogMessage("Emergency close: " + IntegerToString(closed) + " positions");
}
//+------------------------------------------------------------------+
//| Grid Basket Management                                            |
//| CRITICAL: Grid positions close as a basket, not individually     |
//+------------------------------------------------------------------+
void CheckGridBasketTP() {
double profit = 0;
int count = 0;
// Calculate total grid profit
for(int i = PositionsTotal() - 1; i >= 0; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), "GRID") < 0) continue;
  profit += posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
  count++;
}
if(count == 0) {
g_partialExitDone = false;
return;
}
double eq = accInfo.Equity();
if(eq < DBL_EPSILON) return;
double target = eq * InpBasketTPPercent / 100.0;
double partial = eq * InpGridPartialTPPercent / 100.0;
// Partial exit at 0.1% equity profit
if(profit >= partial && !g_partialExitDone) {
LogMessage("Grid partial TP: $" + DoubleToString(profit, 2));
CloseGridPositions(0.5); // Close 50%
g_partialExitDone = true;
}
// Full exit at 0.2% equity profit
if(profit >= target) {
LogMessage("Grid full TP: $" + DoubleToString(profit, 2));
CloseAllGridPositions();
g_partialExitDone = false;
}
}
void CloseGridPositions(double percent) {
int total = 0;
// Count total grid positions
for(int i = 0; i < PositionsTotal(); i++) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), "GRID") >= 0) total++;
}
int toClose = (int)(total * percent);
int closed = 0;
// Close specified percentage
for(int i = PositionsTotal() - 1; i >= 0 && closed < toClose; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), "GRID") < 0) continue;
  if(trade.PositionClose(posInfo.Ticket())) closed++;
}
}
void CloseAllGridPositions() {
for(int i = PositionsTotal() - 1; i >= 0; i--) {
if(!posInfo.SelectByIndex(i)) continue;
if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
if(StringFind(posInfo.Comment(), "GRID") < 0) continue;
  trade.PositionClose(posInfo.Ticket());
}
}
//+------------------------------------------------------------------+
//| Logging                                                            |
//+------------------------------------------------------------------+
void LogMessage(string msg) {
if(!InpEnableLogging) return;
Print("[", TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS), "] ", msg);
}
//+------------------------------------------------------------------+
//| OnTrade Event Handler - Win/Loss Tracking                        |
//+------------------------------------------------------------------+
void OnTrade() {
datetime from = TimeCurrent() - 3600;
datetime to = TimeCurrent();
if(!HistorySelect(from, to)) return;
int total = HistoryDealsTotal();
if(total == 0) return;
// Process only new deals
for(int i = total - 1; i >= 0; i--) {
ulong ticket = HistoryDealGetTicket(i);
if(ticket <= 0) continue;
if(ticket == g_lastProcessedDeal) break; // Already processed
  // Check if it's our EA's deal
  if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol) continue;
  if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagicNumber) continue;
  
  // Only count position exits
  ENUM_DEAL_ENTRY entryType = (ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY);
  if(entryType != DEAL_ENTRY_OUT) continue;
  
  // Calculate total P&L
  double profit = HistoryDealGetDouble(ticket, DEAL_PROFIT);
  double swap = HistoryDealGetDouble(ticket, DEAL_SWAP);
  double commission = HistoryDealGetDouble(ticket, DEAL_COMMISSION);
  
  double totalPnL = profit + swap + commission;
  
  // Track win/loss
  if(totalPnL > 0.01) {
     g_winningTrades++;
  } else if(totalPnL < -0.01) {
     g_losingTrades++;
  }
  
  g_lastProcessedDeal = ticket;
  
  if(InpDebugMode) {
     LogMessage("Trade Closed #" + IntegerToString(ticket) + " | P&L: $" + DoubleToString(totalPnL, 2));
  }
  
  break; // Process one deal per event
}
}
